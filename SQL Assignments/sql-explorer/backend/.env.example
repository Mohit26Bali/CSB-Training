# Copy to .env (git-ignored). There are NO default passwords: the two APP_* passwords are required, and you choose them.

# The MySQL server that holds the demo databases
DB_HOST=127.0.0.1
DB_PORT=3306

# Used ONLY by `npm run seed -- --yes` to build the databases and create the two app users.
# An account that may create databases and users, e.g. root. Leave the password empty only for a passwordless local server.
ADMIN_USER=root
ADMIN_PASSWORD=

# The two accounts the app itself uses. The seed script creates them; pick any long random passwords.
#   sqlexplorer_ro  SELECT only            (browsing, the queries, the playground)
#   sqlexplorer_rw  SELECT/INSERT/UPDATE/DELETE, no schema rights (the rolled-back sandbox only)
# Generate one:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
APP_RO_PASSWORD=
APP_RW_PASSWORD=

# Optional
# DB_PREFIX=sx_             every demo database is named <prefix><original name>, e.g. sx_org_db, so the seed can never touch
#                           a database you created yourself by running the assignments (org_db, bank_db, ...)
# PORT=4100
# HOST=127.0.0.1            localhost only; change it only if you understand the risk (the playground runs SELECTs for anyone who can reach it)
# MAX_ROWS=500
# RATE_LIMIT_PER_MINUTE=600
# ASSIGNMENTS_DIR=          defaults to the folder that contains 01-..., 02-... (the parent of sql-explorer)
