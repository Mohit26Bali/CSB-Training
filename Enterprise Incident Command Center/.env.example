# Copy this file to .env and fill in real values. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_USER=icc
DB_PASSWORD=change-me

# Secret that signs and verifies JWTs. At least 32 characters. The same value
# must be used by the gateway and every service.
JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more

# Origin of the React app that may call the gateway
CORS_ALLOWED_ORIGIN=http://localhost:5173

# The sync to ServiceNow (D38). "local" (the default) sends nothing. "servicenow" starts the sync job and needs the three values below.
ICC_ITSM_MODE=local
SERVICENOW_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
