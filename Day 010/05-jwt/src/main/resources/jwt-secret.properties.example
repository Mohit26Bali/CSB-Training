# Imported by application.properties (spring.config.import). Git-ignored.
# HMAC-SHA256 signing keys: 32 random bytes (256 bits), Base64. Generate a new one with:
#   openssl rand -base64 32
# Every key listed here can VERIFY tokens; only portal.jwt.active-key-id SIGNS new ones.
# Key rotation: add a new key, switch active-key-id to it, and remove the old key
# once the last token it signed has expired (after access-token-ttl).
portal.jwt.keys.k2026-01=GENERATE_WITH_openssl_rand_-base64_32
portal.jwt.keys.k2026-10=GENERATE_WITH_openssl_rand_-base64_32
