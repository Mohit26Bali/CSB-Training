    {
      "name": "2. Browser (form login, session, CSRF)",
      "item": [
        {
          "name": "Dashboard without login -> redirect to /login",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "dashboard"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 302', () => pm.response.to.have.status(302));",
                  "pm.test('redirects to /login', () => pm.expect(pm.response.headers.get('Location')).to.match(/\\/login$/));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Open the login page (read the CSRF token)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const match = pm.response.text().match(/name=\"_csrf\" value=\"([^\"]+)\"/);",
                  "pm.test('page contains a CSRF token', () => pm.expect(match).to.not.be.null);",
                  "pm.collectionVariables.set('csrf', match[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login without the CSRF token -> 403",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login",
