{
  "info": {
    "name": "01 Basic Security",
    "description": "Run in order. Folder 2 follows the real browser flow: it reads the CSRF token from the login page, logs in with the form, keeps the JSESSIONID cookie, and logs out with a POST.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "csrf",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. REST API (HTTP Basic, stateless)",
      "item": [
        {
          "name": "Public hello (no login)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/public/hello",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "public",
                "hello"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Employees without credentials -> 401 JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "employees"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('JSON error', () => { const e = pm.response.json(); pm.expect(e.error).to.eql('Unauthorized'); pm.expect(e.message).to.eql('Authentication is required to access this resource'); pm.expect(e.path).to.eql('/api/employees'); });",
                  "pm.test('WWW-Authenticate: Basic', () => pm.expect(pm.response.headers.get('WWW-Authenticate')).to.eql('Basic'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Employees as alice (HTTP Basic) -> 200",
          "request": {
            "method": "GET",
            "header": [],
