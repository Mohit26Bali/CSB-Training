                  "pm.test('4 employees', () => pm.expect(pm.response.json()).to.have.length(4));",
                  "pm.test('no session cookie (stateless)', () => pm.expect(pm.response.headers.get('Set-Cookie')).to.be.undefined);"
                ]
              }
            }
          ]
        },
