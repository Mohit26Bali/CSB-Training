        {
          "name": "Login as admin -> /admin/dashboard (session cookie)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Admin@123",
                  "type": "text"
                },
                {
                  "key": "_csrf",
                  "value": "{{csrf}}",
                  "type": "text"
                }
              ]
            },
            "description": "Spring Security 6 adds ?continue to the redirect: it marks that the saved request (/admin/dashboard, the page asked for before the login) should be restored."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 302', () => pm.response.to.have.status(302));",
                  "pm.test('redirects to the saved page /admin/dashboard?continue', () => pm.expect(pm.response.headers.get('Location')).to.match(/\\/admin\\/dashboard(\\?continue)?$/));",
                  "pm.test('session cookie set', () => pm.expect(pm.response.headers.get('Set-Cookie')).to.include('JSESSIONID'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
