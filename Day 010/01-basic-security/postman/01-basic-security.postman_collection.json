                  "value": "{{csrf}}",
                  "type": "text"
                }
              ]
            },
            "description": "A non-browser client gets 204 No Content instead of a redirect page (HTTP Basic is also enabled in this chain)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    }
  ]
}