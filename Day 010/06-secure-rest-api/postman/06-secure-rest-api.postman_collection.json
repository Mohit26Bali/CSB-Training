                  "pm.test('error contract + correlation id = header', () => { const e = pm.response.json(); ['timestamp','status','error','code','message','path','correlationId'].forEach(k => pm.expect(e).to.have.property(k)); pm.expect(e.correlationId).to.eql(pm.response.headers.get('X-Correlation-Id')); });"
