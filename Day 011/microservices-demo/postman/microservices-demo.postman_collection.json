  "item": [
    {
      "name": "1 All services running",
      "item": [
        {
          "name": "Eureka registry lists all services",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{eureka}}/eureka/apps"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const apps = pm.response.json().applications.application;",
                  "const byName = Object.fromEntries(apps.map(a => [a.name, a.instance.length]));",
                  "pm.test('API-GATEWAY, ORDER-SERVICE, PRODUCT-SERVICE registered', () => pm.expect(byName).to.include.keys('API-GATEWAY', 'ORDER-SERVICE', 'PRODUCT-SERVICE'));",
                  "pm.test('two PRODUCT-SERVICE instances under one service ID', () => pm.expect(byName['PRODUCT-SERVICE']).to.eql(2));",
                  "pm.collectionVariables.set('instances', '[]');"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /products/1 via gateway (1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway}}/products/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 from a product-service instance', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('product fields present', () => pm.expect(body).to.include.keys('id', 'name', 'price', 'instance'));",
                  "pm.test('X-Gateway response header added', () => pm.expect(pm.response.headers.get('X-Gateway')).to.eql('api-gateway'));",
                  "const seen = JSON.parse(pm.collectionVariables.get('instances') || '[]');",
                  "if (!seen.includes(body.instance)) seen.push(body.instance);",
                  "pm.collectionVariables.set('instances', JSON.stringify(seen));",
                  "console.log('handled by instance', body.instance);"
                ]
              }
            }
          ]
        },
